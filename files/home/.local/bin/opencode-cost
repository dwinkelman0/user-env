#!/bin/bash
set -euo pipefail

DAYS=7
PASSTHROUGH=()

if (($# > 0)); then
    case "$1" in
        -h | --help)
            echo "usage: opencode-cost [days] [opencode stats flags...]"
            echo ""
            echo "Show per-model cost and token statistics from opencode."
            echo "With the model-router installed, each tier maps to a distinct model,"
            echo "so this gives per-tier spend."
            echo ""
            echo "positional:"
            echo "  days    window in days (default 7); 0 = today"
            echo ""
            echo "flags pass through to \`opencode stats\`, e.g.:"
            echo "  opencode-cost --project \"\"     current project only"
            echo "  opencode-cost --days 30 --models 3   last 30 days, top 3 models"
            exit 0
            ;;
        -*)
            PASSTHROUGH=("$@")
            ;;
        *)
            DAYS="$1"
            PASSTHROUGH=("${@:2}")
            ;;
    esac
fi

exec opencode stats --models --days "$DAYS" "${PASSTHROUGH[@]}"
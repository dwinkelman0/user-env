{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "opencode-model-router",
      { "type": "npm", "package": "opencode-model-router" }
    ]
  ],
  "permission": {
    "edit": {
      "*": "allow",
      "/tmp/**": "allow",
      "~/.config/opencode/**": "ask",
      "AGENTS.md": "ask"
    },
    "read": {
      "*": "allow",
      "/tmp/**": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow"
    }
  }
}
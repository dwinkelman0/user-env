" Colorscheme
colorscheme ron
filetype plugin on
syntax on

" Auto-indentation
filetype plugin indent on
set tabstop=4
set shiftwidth=4
set expandtab

" Mouse interactivity with tabs
set mouse=a

" Line numbers on side
set number

" Highlight search
set hlsearch

" Yank copies to the system clipboard
set clipboard=unnamed

" Key bindings (matching zshrc)
map <M-Right> w
map <M-Left> b
imap <Del> <C-W>

